    <string name="accessibility_service_label">Glotalk — read and translate the screen</string>
    <string name="accessibility_service_description">Glotalk uses this permission to capture what is on screen when you or another app asks it to, then shows the translation on top. It does not read the screen when you have not asked.</string>

    <string name="permission_call_translate_label">Ask Glotalk to translate the screen</string>
    <string name="permission_call_translate_desc">Lets this app ask Glotalk to read and translate what is currently on screen.</string>

