    <string name="accessibility_service_label">VDubbing — read and translate the screen</string>
    <string name="accessibility_service_description">VDubbing uses this permission to capture what is on screen when you or another app asks it to, then shows the translation on top. It does not read the screen when you have not asked.</string>

    <string name="permission_call_translate_label">Ask VDubbing to translate the screen</string>
    <string name="permission_call_translate_desc">Lets this app ask VDubbing to read and translate what is currently on screen.</string>

