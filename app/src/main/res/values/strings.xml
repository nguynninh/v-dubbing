    <string name="settings_section_diagnostics">Chẩn đoán Trợ năng</string>
    <string name="settings_diagnostics_hint">Nếu bạn đã bật trong Cài đặt mà mục trên vẫn báo chưa bật, đối chiếu hai dòng dưới đây — chúng cho biết hệ thống lưu tên service là gì so với tên app tìm.</string>
    <string name="settings_bubble_hint">Bong bóng chữ TA nổi trên màn hình khi service nền chạy: chạm để mở bảng dịch, nhấn giữ để mở menu nhanh (tạm dừng, ngôn ngữ, cài đặt, ẩn, thoát), kéo để dời. Khi đang có bản dịch nó chuyển thành ✕ đỏ để tắt.</string>
    <string name="settings_developer_hint">Nhà phát triển: xem docs/INTEGRATION.md để bind service và nhận JSON.</string>

