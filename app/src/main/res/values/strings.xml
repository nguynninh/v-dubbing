<resources>
    <!-- Manifest, accessibility config, notification channel -->
    <string name="accessibility_service_label">VDubbing — đọc và dịch màn hình</string>
    <string name="accessibility_service_description">VDubbing dùng quyền này để chụp nội dung đang hiển thị khi bạn hoặc một app khác yêu cầu, rồi hiển thị bản dịch đè lên màn hình. Không đọc nội dung khi bạn không yêu cầu.</string>

    <string name="permission_call_translate_label">Gọi VDubbing dịch màn hình</string>
    <string name="permission_call_translate_desc">Cho phép app này yêu cầu VDubbing đọc và dịch nội dung đang hiển thị trên màn hình.</string>

    <string name="notif_channel_name">Dịch nền</string>
    <string name="notif_channel_desc">Hiển thị khi VDubbing sẵn sàng dịch theo yêu cầu.</string>
    <string name="notif_title">VDubbing đang chạy nền</string>
